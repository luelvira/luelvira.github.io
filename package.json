{
  "name": "hugo_website",
  "version": "1.0.0",
  "main": "tailwind.config.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "run-p dev-hugo dev-sass",
    "tailwind": "npx tailwindcss -i ./src/css/main.css -o ./assets/css/main.css --watch",
    "dev-hugo": "hugo server --gc",
    "dev-tailwind": "npx postcss src/scss/main.scss -o assets/css/main.css --watch",
    "dev-sass": "sass src/scss/main.scss ./assets/css/main.css --watch"
  },
