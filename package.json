  "description": "",
  "devDependencies": {
    "@csstools/postcss-sass": "^5.1.1",
    "autoprefixer": "^10.4.20",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.41",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.0",
    "postcss-normalize": "^10.0.1",
    "postcss-scss": "^4.0.9",
    "tailwindcss": "^3.4.9"
  },
  "dependencies": {
    "normalize-scss": "^8.0.0",
    "normalize.css": "^8.0.1",
    "normalize.scss": "^0.1.0"
  }
